---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Invitacion from "../components/Invitacion.astro";
---

<Layout tittle="Coro Mozart Historico">
	<Header />
	<main class="h-full flex bg-black">
		<section
			class="bg-slate-200 min-h-screen xl:h-auto relative flex flex-col text-center text-white items-center w-full"
		>
			<div class="bg-gray-800 xl:p-4 md:p-3 p-2 w-full z-20">
				<h1
					class="xl:text-6xl md:text-4xl text-2xl"
					style="font-family: BeVietnamPro;"
				>
					Contacto
				</h1>
			</div>

			<div class="w-full max-h-32 px-4 py-8 z-20">
				<div class="grid h-full gap-8 md:grid-cols-2">
					<iframe
						class="w-full rounded-xl shadow-xl"
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1664.4635551495587!2d-70.65850226110899!3d-33.45120549334736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c508a37ea763%3A0x685ce5653f8e170f!2sDieciocho%20390%2C%208330526%20Santiago%2C%20Regi%C3%B3n%20Metropolitana!5e0!3m2!1ses-419!2scl!4v1742085593343!5m2!1ses-419!2scl"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"></iframe>

					<div
						class="text-center"
					>
						<h2
							class="xl:text-3xl text-xl font-bold text-gray-800 mb-4"
						>
							Información de Contacto
						</h2>
						<div class="space-y-4 text-center flex flex-col items-center">
							<div class="flex items-center gap-3">
								<span class="text-blue-500 text-2xl">📍</span>
								<p class="text-gray-700 text-xl">
									Calle Dieciocho 390, Santiago Centro
								</p>
							</div>
							<div class="flex items-center gap-3">
								<span class="text-green-500 text-2xl">📞</span>
								<a
									href="tel:+56973367583"
									class="text-xl text-gray-700 hover:text-green-600 transition"
									>+56 9 7336 7583</a
								>
							</div>
							<div class="flex items-center gap-3 overflow-auto">
								<span class="text-red-500 text-2xl">📧</span>
								<a
									href="mailto:coromozarthistoricodechile@gmail.com"
									class="text-xl text-gray-700 hover:text-red-600 transition"
									>coromozarthistoricodechile@gmail.com</a
								>
							</div>
						</div>

						<div class="mt-6 flex justify-center gap-4">
							<a
								href="tel:+56973367583"
								class="bg-green-500 text-white px-4 py-2 rounded-lg shadow-md hover:bg-green-600 transition"
								>Llamar</a
							>
							<a
								href="mailto:coromozarthistoricodechile@gmail.com"
								class="bg-blue-500 text-white px-4 py-2 rounded-lg shadow-md hover:bg-blue-600 transition"
								>Enviar Email</a
							>
						</div>
					</div>
				</div>
			</div>
			<div class="mb-8">
				<Invitacion />
			</div>

			<div
				class="bg-white/90 shadow-xl rounded-2xl p-8 text-left mt-8"
			>
				<h2 class="text-2xl font-bold text-gray-800 mb-4">
					Formulario de contacto
				</h2>
				<p class="text-gray-700 mb-4">
					Dejanos tus datos y tu voz para que te contacte nuestro
					equipo.
				</p>
				<form
					action="mailto:coromozarthistoricodechile@gmail.com"
					method="POST"
					enctype="text/plain"
					class="space-y-4"
				>
					<div>
						<label
							class="block mb-1 font-medium text-gray-700"
							for="nombre">Nombre completo</label
						>
						<input
							class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
							type="text"
							id="nombre"
							name="Nombre"
							required
						/>
					</div>
					<div>
						<label
							class="block mb-1 font-medium text-gray-700"
							for="email">Correo electrónico</label
						>
						<input
							class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
							type="email"
							id="email"
							name="Email"
							required
						/>
					</div>
					<div>
						<label
							class="block mb-1 font-medium text-gray-700"
							for="voz">Voz / Sección</label
						>
						<select
							id="voz"
							name="Voz"
							class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
						>
							<option value="">Selecciona una opción</option>
							<option value="Soprano">Soprano</option>
							<option value="Contralto">Contralto</option>
							<option value="Tenor">Tenor</option>
							<option value="Bajo">Bajo</option>
							<option value="Otra">Otra</option>
						</select>
					</div>
					<div>
						<label
							class="block mb-1 font-medium text-gray-700"
							for="mensaje">Mensaje</label
						>
						<textarea
							id="mensaje"
							name="Mensaje"
							rows="4"
							class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
							placeholder="Escribe tu consulta"
							required></textarea>
					</div>
					<div class="flex justify-end">
						<button
							type="submit"
							class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-semibold"
							>Enviar mensaje</button
						>
					</div>
				</form>
				<p class="mt-3 text-sm text-gray-500">
					Nota: Este formulario abrirá tu cliente de correo con
					los datos.
				</p>
			</div>
			
		</section>
	</main>
	<Footer />
</Layout>
