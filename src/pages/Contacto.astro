						<h2 class="xl:text-3xl text-xl font-bold text-gray-800 mb-4">Información de Contacto</h2>
						
						<div class="space-y-4">
							<!-- Dirección -->
							<div class="flex items-center gap-3">
								<span class="text-blue-500 text-2xl">📍</span>
								<p class="text-gray-700 text-xl">Calle Dieciocho 390, Santiago Centro</p>
							</div>
				
							<!-- Teléfono -->
							<div class="flex items-center gap-3">
								<span class="text-green-500 text-2xl">📞</span>
								<a href="tel:+56973367583" class="text-xl text-gray-700 hover:text-green-600 transition">
									+56 9 7336 7583
								</a>
							</div>
				
							<!-- Correo -->
							<div class="flex items-center gap-3  overflow-auto">
								<span class="text-red-500 text-2xl">📧</span>
								<a href="mailto:coromozarthistoricodechile@gmail.com" 
								   class="text-xl text-gray-700 hover:text-red-600 transition">
									coromozarthistoricodechile@gmail.com
								</a>
							</div>
						</div>
				
						<!-- Botones de contacto -->
						<div class="mt-6 flex justify-center gap-4">
							<a href="tel:+56973367583" 
							   class="bg-green-500 text-white px-4 py-2 rounded-lg shadow-md hover:bg-green-600 transition">
								Llamar
							</a>
							<a href="mailto:coromozarthistoricodechile@gmail.com" 
							   class="bg-blue-500 text-white px-4 py-2 rounded-lg shadow-md hover:bg-blue-600 transition">
