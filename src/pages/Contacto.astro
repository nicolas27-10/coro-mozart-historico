		<section class="bg-slate-300 h-screen xl:h-full relative flex flex-col text-center text-white items-center w-full">
            <div class="bg-gray-800 xl:p-4 md:p-3 p-2 xl:sticky w-full z-20 " style="">
                <h1 class="xl:text-6xl md:text-4xl text-2xl" style="font-family: BeVietnamPro;">Contacto</h1>
            </div>

			<section class="xl:w-[1650px] w-full mx-5 my-10">
				<div class="flex md:flex-row flex-col m-5 justify-between items-center h-full gap-y-5 gap-10 xl:mx-32">
					<iframe class="w-full h-full md:w-[650px] md:h-[400px] xl:w-[800px] xl:h-[550px]" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1664.4635551495587!2d-70.65850226110899!3d-33.45120549334736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c508a37ea763%3A0x685ce5653f8e170f!2sDieciocho%20390%2C%208330526%20Santiago%2C%20Regi%C3%B3n%20Metropolitana!5e0!3m2!1ses-419!2scl!4v1742085593343!5m2!1ses-419!2scl" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
						

