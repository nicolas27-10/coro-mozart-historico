---
import Layout from "../layouts/Layout.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
---

<Layout tittle="Coro Mozart Historico">
	<Header/>
	<main class="min-h-screen bg-black snap-mandatory">
		<section class="bg-slate-300 h-screen relative flex flex-col text-center text-white"  >
            <!-- <div class="bg-gray-800 xl:p-4 md:p-3 p-2 xl:fixed w-screen z-20 " style="top: 80px;">
                <h1 class="xl:text-6xl md:text-4xl text-2xl" style="font-family: BeVietnamPro;">Repertorio</h1>
            </div> -->
            
            
            <section class="relative min-h-screen flex items-center justify-center bg-cover bg-center" 
            style="background-image: url('/cortina.jpg');">
            
            <!-- Fondo Oscuro para Mejorar Legibilidad -->
            <div class="absolute inset-0 bg-black/60"></div>
            
            <div class="relative max-w-4xl bg-white/10 backdrop-blur-lg p-8 rounded-xl shadow-lg border border-white/20 text-center">
                <h2 class="text-5xl font-bold text-white mb-6">Repertorio</h2>
                
                <p class="text-xl text-gray-200 mb-4">
                    El Coro Mozart Histórico interpreta un repertorio variado que incluye:
                </p>
                
                <!-- Lista del repertorio -->
                <ul class="text-left text-gray-300 space-y-3 text-2xl">
                    <li class="flex items-center gap-2">
                        🎼 <span><strong>Música clásica coral:</strong> Mozart, Schubert, Vivaldi, Bach</span>
                    </li>
                    <li class="flex items-center gap-2">
                        🌎 <span><strong>Folclore latinoamericano:</strong> Violeta Parra, Mercedes Sosa, Inti-Illimani</span>
                    </li>
                    <li class="flex items-center gap-2">
                        🎤 <span><strong>Música popular:</strong> Tangos, boleros y canciones con arreglos corales</span>
                    </li>
                    <li class="flex items-center gap-2">
                        🎻 <span>Arreglos de músicos chilenos para un sello distintivo</span>
                    </li>
                </ul>
            </div>
        </section>
    </section>
        
	</main>   
	<Footer/>
</Layout>